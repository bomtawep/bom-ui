{
  "name": "@bomtawep/ui",
  "version": "0.1.8",
  "description": "React component library for Next.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./source.css": "./dist/source.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bomtawep/bom-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "yarn typecheck && yarn build && sh scripts/check-dist.sh",
    "release": "sh scripts/release.sh"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.55.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@hookform/resolvers": "5.9.2",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  }
}
